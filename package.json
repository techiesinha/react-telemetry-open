{
  "name": "react-telemetry-open",
  "version": "1.0.2",
  "description": "React-aware, vendor-neutral observability for React 18+ applications. Zero boilerplate. OTLP/HTTP output.",
  "author": "Abhishek Sinha <sinha@live.in>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/techiesinha/react-telemetry-open"
  },
  "keywords": [
    "react",
    "telemetry",
    "observability",
    "opentelemetry",
    "otel",
    "otlp",
    "performance",
    "monitoring",
    "web-vitals",
    "tracing"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./renders": {
      "import": "./dist/renders.esm.js",
      "require": "./dist/renders.cjs.js",
      "types": "./dist/renders.d.ts"
    },
    "./interactions": {
      "import": "./dist/interactions.esm.js",
      "require": "./dist/interactions.cjs.js",
      "types": "./dist/interactions.d.ts"
    },
    "./routes": {
      "import": "./dist/routes.esm.js",
      "require": "./dist/routes.cjs.js",
      "types": "./dist/routes.d.ts"
    },
    "./custom-events": {
      "import": "./dist/custom-events.esm.js",
      "require": "./dist/custom-events.cjs.js",
      "types": "./dist/custom-events.d.ts"
    },
    "./exporters/console": {
      "import": "./dist/exporters/console.esm.js",
      "require": "./dist/exporters/console.cjs.js",
      "types": "./dist/exporters/console.d.ts"
    },
    "./exporters/otlp": {
      "import": "./dist/exporters/otlp.esm.js",
      "require": "./dist/exporters/otlp.cjs.js",
      "types": "./dist/exporters/otlp.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.esm.js",
      "require": "./dist/testing.cjs.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "bin": {
    "react-telemetry-open": "./bin/cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
